// Benchmark 01: Arithmetic - Prime calculation and numeric series
fn is_prime(n):
    if n <= 1:
        return false
    let mut i = 2
    while i * i <= n:
        if n % i == 0:
            return false
        i = i + 1
    return true

fn count_primes(limit):
    let mut count = 0
    let mut n = 2
    while n <= limit:
        if is_prime(n):
            count = count + 1
        n = n + 1
    return count

let total_primes = count_primes(5000)
print(total_primes)
