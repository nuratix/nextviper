// Benchmark 06: Maps - Hash map insertions, lookups, and aggregation
fn map_benchmark(n):
    let m = {}
    let mut i = 0
    while i < n:
        let key = str(i % 500)
        m[key] = (i * 3) + 7
        i = i + 1
    
    let mut sum = 0
    let mut j = 0
    while j < 500:
        let k = str(j)
        sum = sum + m[k]
        j = j + 1
    return sum

let total = map_benchmark(5000)
print(total)
