// Benchmark 05: Lists - Dynamic array building, indexing and accumulation
fn list_benchmark(n):
    let mut lst = []
    let mut i = 0
    while i < n:
        append(lst, i * 2 + 1)
        i = i + 1
    
    let mut sum = 0
    let mut j = 0
    let list_len = len(lst)
    while j < list_len:
        sum = sum + lst[j]
        j = j + 1
    return sum

let total = list_benchmark(10000)
print(total)
