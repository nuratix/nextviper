#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer MatrixA {
    float a[];
};

layout(std430, binding = 1) readonly buffer MatrixB {
    float b[];
};

layout(std430, binding = 2) writeonly buffer MatrixC {
    float c[];
};

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint N;
} dims;

shared float tileA[16][16];
shared float tileB[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint lx = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;

    float sum = 0.0;
    uint numTiles = (dims.K + 15u) / 16u;

    for (uint t = 0u; t < numTiles; ++t) {
        uint aCol = t * 16u + lx;
        uint bRow = t * 16u + ly;

        if (row < dims.M && aCol < dims.K) {
            tileA[ly][lx] = a[row * dims.K + aCol];
        } else {
            tileA[ly][lx] = 0.0;
        }

        if (bRow < dims.K && col < dims.N) {
            tileB[ly][lx] = b[bRow * dims.N + col];
        } else {
            tileB[ly][lx] = 0.0;
        }

        barrier();

        for (uint k = 0u; k < 16u; ++k) {
            sum += tileA[ly][k] * tileB[k][lx];
        }

        barrier();
    }

    if (row < dims.M && col < dims.N) {
        c[row * dims.N + col] = sum;
    }
}
