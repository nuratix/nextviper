{
  "name": "nextviper-vscode",
  "displayName": "NextViper Language Support",
  "description": "Official VS Code language support, syntax highlighting, and LSP integration for NextViper",
  "version": "1.0.0",
  "publisher": "nuratix",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nextviper",
        "aliases": [
          "NextViper",
          "nextviper",
          "nv"
        ],
        "extensions": [
          ".nv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nextviper",
        "scopeName": "source.nextviper",
        "path": "./syntaxes/nextviper.tmLanguage.json"
      }
    ]
  }
}
