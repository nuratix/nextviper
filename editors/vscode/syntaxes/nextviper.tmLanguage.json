{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NextViper",
  "scopeName": "source.nextviper",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#modules" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nextviper",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nextviper",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nextviper",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nextviper",
              "match": "\\\\([\\\\\"ntr0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.nextviper",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.nextviper",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nextviper",
          "match": "\\b(if|elif|else|while|for|in|return|break|continue|match|loop)\\b"
        },
        {
          "name": "keyword.declaration.nextviper",
          "match": "\\b(let|mut|fn|struct|type|import|from|as|export)\\b"
        },
        {
          "name": "keyword.operator.logical.nextviper",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.nextviper",
          "match": "\\b(int|float|string|bool|list|map|any|Tensor|DataFrame|Future)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.nextviper",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.nextviper",
          "match": "\\b(null|nil)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.nextviper" },
            "2": { "name": "entity.name.function.nextviper" }
          }
        },
        {
          "name": "support.function.builtin.nextviper",
          "match": "\\b(print|len|str|int|float|type|range|abs)\\b"
        },
        {
          "name": "entity.name.function.call.nextviper",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nextviper",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.nextviper",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.nextviper",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.nextviper",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.nextviper",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.nextviper",
          "match": "(=>|->)"
        },
        {
          "name": "keyword.operator.comparison.nextviper",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.nextviper",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.nextviper",
          "match": "(\\+|-|\\*\\*|\\*|/|%|\\^)"
        },
        {
          "name": "keyword.operator.range.nextviper",
          "match": "(\\.\\.=|\\.\\.)"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "match": "\\b(import)\\s+([a-zA-Z0-9_.]+)",
          "captures": {
            "1": { "name": "keyword.control.import.nextviper" },
            "2": { "name": "entity.name.namespace.nextviper" }
          }
        }
      ]
    }
  }
}
