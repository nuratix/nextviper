{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NextViper",
  "scopeName": "source.nextviper",
  "patterns": [
    {
      "name": "comment.line.double-slash.nextviper",
      "match": "//.*$"
    },
    {
      "name": "comment.block.nextviper",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.nextviper",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nextviper",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.nextviper",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.nextviper",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.nextviper",
      "match": "\\b(if|else|while|for|in|return|break|continue|match|import|export|from|as|try|catch|finally|throw)\\b"
    },
    {
      "name": "keyword.declaration.nextviper",
      "match": "\\b(fn|let|mut|const|type|struct|enum|interface|class)\\b"
    },
    {
      "name": "storage.type.nextviper",
      "match": "\\b(int|float|string|bool|void|nil|Tensor|DataFrame|List|Map|Array|Future)\\b"
    },
    {
      "name": "constant.language.nextviper",
      "match": "\\b(true|false|nil|null|none)\\b"
    },
    {
      "name": "constant.numeric.float.nextviper",
      "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
    },
    {
      "name": "constant.numeric.integer.nextviper",
      "match": "\\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9_]+)\\b"
    },
    {
      "name": "keyword.operator.pipe.nextviper",
      "match": "\\|>"
    },
    {
      "name": "keyword.operator.nextviper",
      "match": "(==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|%|=|\\+=|-=|\\*=|/=|!|<|>)"
    },
    {
      "name": "entity.name.function.nextviper",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
    }
  ]
}
