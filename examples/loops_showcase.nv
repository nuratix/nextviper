// NextViper Modern Loop Showcase

print("--- 1. Range Loop (Half-Open 0..5) ---")
for i in 0..5:
    print("i =", i)

print("\n--- 2. Inclusive Range Loop (1..=5) ---")
for i in 1..=5:
    print("i =", i)

print("\n--- 3. Iterating Over Collections ---")
let fruits = ["Apple", "Banana", "Cherry", "Dragonfruit"]
for fruit in fruits:
    print("Fruit:", fruit)

print("\n--- 4. While Loop with Condition ---")
let mut countdown = 3
while countdown > 0:
    print("Countdown:", countdown)
    countdown = countdown - 1
print("Blast off! 🚀")

print("\n--- 5. Break and Continue ---")
print("Printing only odd numbers up to 7:")
for num in 0..10:
    if num > 7:
        break
    if num % 2 == 0:
        continue
    print("Odd number:", num)

print("\n--- 6. Nested Loops (2D Grid Multiplication) ---")
for row in 1..=3:
    for col in 1..=3:
        print(row, "x", col, "=", row * col)
