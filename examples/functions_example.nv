// NextViper Functions Example

fn add(a, b):
    return a + b

result = add(10, 20)
print("Untyped function result:", result)

// Optional type annotations
fn multiply(a: int, b: int) -> int:
    return a * b

print("Typed function result:  ", multiply(6, 7))

// Recursion: Fibonacci
fn fib(n):
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)

print("Fibonacci(10):          ", fib(10))

// Higher-order functions and closures
fn make_multiplier(factor):
    fn mult(x):
        return x * factor
    return mult

let triple = make_multiplier(3)
print("Closure triple(14):     ", triple(14))
