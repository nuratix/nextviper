// NextViper AI & Data Capabilities Showcase
// Demonstrates: Data loading, cleaning, shuffling, tensor manipulation, and model prediction

import data
import ai
import tensor

print("=== NextViper AI & Data Pipeline ===")

// 1. Tabular Dataset Ingestion and Preprocessing
let raw_csv = "age,income,score,purchased\n25,50000,85.5,1\n30,null,92.0,1\nnull,45000,60.0,0\n40,80000,95.0,1\n22,30000,50.0,0\n35,65000,null,1"
let dataset = data.from_csv(raw_csv)
print("Initial Dataset Rows: " + str(dataset.num_rows))

// Clean dataset (fill missing values using mean strategy)
let clean_ds = dataset.clean(false, "mean")
print("Cleaned Dataset Rows: " + str(clean_ds.num_rows))

// Shuffle dataset with deterministic seed
let shuffled_ds = clean_ds.shuffle(42)
let splits = shuffled_ds.split(0.8)
let train_ds = splits[0]
let test_ds = splits[1]

print("Train Split Rows: " + str(train_ds.num_rows))
print("Test Split Rows: " + str(test_ds.num_rows))

// 2. High-Performance Tensor Operations
let X = ai.tensor([4, 3], [
    25.0, 50000.0, 85.5,
    30.0, 54000.0, 92.0,
    32.0, 45000.0, 60.0,
    40.0, 80000.0, 95.0
])

print("Tensor Shape: " + str(X.shape))
print("Tensor Element Count: " + str(X.numel))

// 3. AI Model Construction & Inference
let model = ai.linear(3, 1)
let predictions = model.predict(X)

print("Inference Output Shape: " + str(predictions.shape))
print("Inference Output:")
print(predictions.to_string())

print("=== Pipeline Completed Successfully ===")
