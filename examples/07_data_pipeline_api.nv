// NextViper Production Example 07: Real-Time Data Pipeline & Analytics
// In-memory Columnar DataFrames, vectorization, statistical analysis, and dataset splitting.

import std.io
import std.data
import std.log

log.info("Starting High-Throughput Columnar Data Processing Pipeline...")

let transactions_csv = "id,score\n101,120.5\n102,450.0\n103,89.0\n104,3400.0\n105,15.5\n"

let df = data.read_csv(transactions_csv)
log.info("Loaded DataFrame with " + str(df.shape[0]) + " rows and " + str(df.shape[1]) + " columns.")

// 1. Vectorized array statistics
let arr = data.arange(1.0, 10.0, 1.0)
let mean_val = arr.mean()
let sum_val = arr.sum()

io.print("Array mean: " + str(mean_val) + " | sum: " + str(sum_val))

// 2. Normalize DataFrame features
let norm_df = df.normalize()
io.print("Normalized DataFrame shape: [" + str(norm_df.shape[0]) + ", " + str(norm_df.shape[1]) + "]")

// 3. Train/Test Split
let splits = df.split(0.8, 42)
let train_df = splits[0]
let test_df = splits[1]

io.print("Train partition rows: " + str(train_df.shape[0]))
io.print("Test partition rows: " + str(test_df.shape[0]))

log.info("Columnar analytics pipeline completed successfully.")
