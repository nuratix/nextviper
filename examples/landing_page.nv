fn render_features_grid(features):
    let mut html = "<section class='features-section'><div class='container'><h2 class='section-title'>Engineered for Raw Speed & Simplicity</h2><div class='features-grid'>"
    for f in features:
        html = html + """
        <div class="feature-card">
          <div class="feature-icon">""" + f["icon"] + """</div>
          <h3 class="feature-title">""" + f["title"] + """</h3>
          <p class="feature-desc">""" + f["desc"] + """</p>
        </div>
        """
    html = html + "</div></div></section>"
    return html

fn render_benchmarks_section(benchmarks, stats):
    let mut rows = ""
    for b in benchmarks:
        let speedup = str(compute_speedup(b["nv_native"], b["python"])) + "x"
        rows = rows + """
        <tr>
          <td class="bench-name">""" + b["name"] + """</td>
          <td class="bench-nv">""" + str(b["nv_native"]) + " ms" + """</td>
          <td class="bench-py">""" + str(b["python"]) + " ms" + """</td>
          <td class="bench-speedup">""" + speedup + " faster" + """</td>
        </tr>
        """

    return """
    <section class="benchmarks-section">
      <div class="container">
        <h2 class="section-title">Empirical Benchmark Latency</h2>
        <p class="section-subtitle">Measured across 5 runs on ARM64 Linux vs Python 3.14 (Lower latency is better)</p>
        
        <div class="stats-banner">
          <div class="stat-item">
            <div class="stat-value">""" + str(stats["max_speedup"]) + """x</div>
            <div class="stat-label">Peak Compute Speedup</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">""" + str(stats["average_speedup"]) + """x</div>
            <div class="stat-label">Average Workload Speedup</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">0 ms</div>
            <div class="stat-label">GC Pause Latency (RAII)</div>
          </div>
        </div>

        <div class="table-container">
          <table class="bench-table">
            <thead>
              <tr>
                <th>Workload</th>
                <th>NextViper Native</th>
                <th>Python 3.14</th>
                <th>Measured Speedup</th>
              </tr>
            </thead>
            <tbody>
              """ + rows + """
            </tbody>
          </table>
        </div>
      </div>
    </section>
    """

fn render_code_showcase():
    return """
    <section class="code-showcase-section">
      <div class="container">
        <h2 class="section-title">Expressive, Beautiful NextViper Syntax</h2>
        <div class="code-editor-mock">
          <div class="editor-header">
            <span class="window-dot dot-red"></span>
            <span class="window-dot dot-yellow"></span>
            <span class="window-dot dot-green"></span>
            <span class="editor-filename">neural_tensor_pipeline.nv</span>
          </div>
          <pre class="code-content"><code><span class="kw">import</span> std.io
<span class="kw">import</span> std.data
<span class="kw">import</span> std.tensor
<span class="kw">import</span> std.ai
<span class="kw">import</span> std.gpu

<span class="cm">// 1. Columnar Data Ingestion with Vectorization</span>
<span class="kw">let</span> df = data.DataFrame.read_csv(<span class="str">"sensor_data.csv"</span>)
<span class="kw">let</span> train_data = df.filter(<span class="kw">fn</span>(row) => row[<span class="str">"status"</span>] == <span class="str">"active"</span>)

<span class="cm">// 2. N-Dimensional Tensor on Vulkan GPU Device</span>
<span class="kw">let</span> X = tensor.from_matrix(train_data.to_matrix(), device = <span class="str">"gpu"</span>)
<span class="kw">let</span> model = ai.Dense(in_features = 8, out_features = 2, activation = <span class="str">"relu"</span>)

<span class="cm">// 3. Forward Pass & Autograd Gradient Calculation</span>
<span class="kw">let</span> output = model.forward(X)
<span class="kw">let</span> loss = output.sum()
loss.backward()

io.print(<span class="str">"✓ Optimization step completed on Vulkan compute backend."</span>)</code></pre>
        </div>
      </div>
    </section>
    """

