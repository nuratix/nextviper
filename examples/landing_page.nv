    .btn-hero-secondary { border: 1px solid var(--border); color: #fff; padding: 12px 28px; border-radius: 8px; font-family: var(--font-mono); text-decoration: none; font-size: 0.95rem; }
    .btn-hero-secondary:hover { background: #27272a; }
    
    /* Install Box */
    .install-box { max-width: 640px; margin: 0 auto; background: #000; border: 1px solid var(--border); border-radius: 12px; padding: 18px; text-align: left; font-family: var(--font-mono); font-size: 0.85rem; }
    .install-header { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 10px; }
