    .npx-hint code { color: #38bdf8; }
    
    /* Features */
    .features-section { padding: 60px 0; border-top: 1px solid var(--border); }
    .section-title { font-family: var(--font-mono); font-size: 2rem; font-weight: 800; text-align: center; margin-bottom: 40px; }
    .section-subtitle { text-align: center; color: var(--text-muted); font-size: 0.9rem; font-family: var(--font-mono); margin-top: -30px; margin-bottom: 30px; }
    .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; }
    .feature-card { background: var(--card-bg); border: 1px solid var(--border); padding: 24px; border-radius: 12px; }
    .feature-icon { font-size: 1.8rem; margin-bottom: 12px; }
    .feature-title { font-family: var(--font-mono); font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; color: #fff; }
    .feature-desc { font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; }
    
    /* Benchmarks */
    .benchmarks-section { padding: 60px 0; border-top: 1px solid var(--border); }
    .stats-banner { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px; text-align: center; }
    .stat-item { background: var(--card-bg); border: 1px solid var(--border); padding: 20px; border-radius: 12px; }
    .stat-value { font-family: var(--font-mono); font-size: 2rem; font-weight: 900; color: var(--emerald); }
    .stat-label { font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 4px; }
    .table-container { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
    .bench-table { width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-mono); font-size: 0.85rem; }
    .bench-table th, .bench-table td { padding: 14px 18px; border-bottom: 1px solid var(--border); }
    .bench-table th { background: #27272a; color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; }
    .bench-nv { color: var(--emerald); font-weight: 700; }
    .bench-py { color: #a1a1aa; }
    .bench-speedup { color: #34d399; font-weight: 700; }
    
    /* Code Editor Mock */
    .code-showcase-section { padding: 60px 0; border-top: 1px solid var(--border); }
    .code-editor-mock { background: #000; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.6); }
    .editor-header { display: flex; align-items: center; gap: 8px; padding: 12px 18px; background: #121215; border-bottom: 1px solid var(--border); font-family: var(--font-mono); font-size: 0.8rem; }
    .window-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .dot-red { background: #ef4444; } .dot-yellow { background: #f59e0b; } .dot-green { background: #10b981; }
    .editor-filename { margin-left: 12px; color: var(--text-muted); }
    .code-content { padding: 24px; font-family: var(--font-mono); font-size: 0.9rem; line-height: 1.7; overflow-x: auto; color: #e4e4e7; }
    .kw { color: #f43f5e; font-weight: 700; }
    .str { color: #34d399; }
    .cm { color: #71717a; font-style: italic; }
    
    /* Footer */
    .footer { border-top: 1px solid var(--border); padding: 60px 0; background: #050507; font-family: var(--font-mono); font-size: 0.8rem; }
    .footer-content { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 40px; }
    .footer-brand { max-width: 320px; }
    .brand-title { font-size: 1.2rem; font-weight: 800; color: #fff; margin-bottom: 8px; display: block; }
    .footer-desc { color: var(--text-muted); font-size: 0.8rem; margin-bottom: 12px; }
    .copyright { color: #52525b; font-size: 0.75rem; }
    .footer-links { display: flex; gap: 50px; flex-wrap: wrap; }
    .footer-links h4 { color: #fff; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 12px; }
    .footer-links a { display: block; color: var(--text-muted); text-decoration: none; margin-bottom: 8px; transition: color 0.2s; }
    .footer-links a:hover { color: var(--emerald); }
    
    @media(max-width: 768px) {
      .hero-title { font-size: 2.2rem; }
      .stats-banner { grid-template-columns: 1fr; }
      .footer-content { flex-direction: column; }
    }
    """

// ------------------------------------------------------------------------------
// 4. Main Assembly & Execution Entrypoint
// ------------------------------------------------------------------------------

export fn generate_landing_page(output_path: string):
    io.print("=== NextViper Landing Page Generator ===")
    io.print("Loading data models and state...")
    
    let hero = get_hero_data()
    let features = get_core_features()
    let benchmarks = get_benchmark_data()
    let stats = compute_overall_stats(benchmarks)
    
    io.print("Computed Average Speedup: " + str(stats["average_speedup"]) + "x across " + str(stats["benchmark_count"]) + " benchmarks.")
    io.print("Compiling NextViper HTML components...")
    
    let nav_html = render_nav_header()
    let hero_html = render_hero_section(hero)
    let feat_html = render_features_grid(features)
    let bench_html = render_benchmarks_section(benchmarks, stats)
    let code_html = render_code_showcase()
    let foot_html = render_footer()
    let css = build_css_styles()
    
    let full_document = """<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>""" + hero["title"] + """ — Official Landing Page</title>
  <meta name="description" content=\"""" + hero["description"] + """\">
  <link rel="icon" href="https://nextviper.nuratix.com/favicon.png" type="image/png">
  <style>
""" + css + """
  </style>
</head>
<body>
""" + nav_html + hero_html + feat_html + bench_html + code_html + foot_html + """
</body>
</html>"""
    
    io.print("Writing generated HTML document to: " + output_path)
    fs.write_file(output_path, full_document)
    io.print("✓ NextViper Landing Page generated successfully!")

// Execute generator
export fn run():
    let target = "/root/code/NextViperweb/public/landing.html"
    generate_landing_page(target)

run()
