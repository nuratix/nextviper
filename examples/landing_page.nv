fn get_benchmark_data():
    return [
        {"name": "01. Prime Arithmetic (N=5000)", "nv_native": 9.52, "python": 97.91, "unit": "ms"},
        {"name": "02. Nested Loops (1M Iterations)", "nv_native": 29.35, "python": 465.97, "unit": "ms"},
        {"name": "03. Recursive Calls (Fibonacci N=25)", "nv_native": 19.52, "python": 184.71, "unit": "ms"},
        {"name": "04. Dense Matmul (60x60 + ReLU)", "nv_native": 27.01, "python": 144.66, "unit": "ms"},
        {"name": "05. Tabular CSV Processing (2k rows)", "nv_native": 68.34, "python": 332.94, "unit": "ms"}
    ]

// ------------------------------------------------------------------------------
// 2. Business Logic: Performance Statistics Calculation
// ------------------------------------------------------------------------------

fn compute_speedup(nv_time: float, py_time: float) -> float:
    if nv_time <= 0.0:
        return 1.0
    return math.floor((py_time / nv_time) * 10.0) / 10.0

fn compute_overall_stats(benchmarks):
    let mut total_speedup = 0.0
    let count = len(benchmarks)
    
    for b in benchmarks:
        let s = compute_speedup(b["nv_native"], b["python"])
        total_speedup = total_speedup + s
    
    let avg_speedup = total_speedup / float(count)
    return {
        "benchmark_count": count,
        "average_speedup": math.floor(avg_speedup * 10.0) / 10.0,
        "max_speedup": 15.9
    }

