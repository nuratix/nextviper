    header { border-bottom: 1px solid var(--border); padding: 18px 0; background: #09090b; }
    .nav { display: flex; justify-content: space-between; align-items: center; }
    .brand { font-family: var(--font-mono); font-weight: 800; font-size: 1.25rem; color: #fff; text-decoration: none; display: flex; align-items: center; gap: 8px; }
    .badge { font-size: 0.75rem; background: rgba(16,185,129,0.1); color: var(--emerald); border: 1px solid rgba(16,185,129,0.3); padding: 2px 8px; border-radius: 99px; }
    .server-status { font-family: var(--font-mono); font-size: 0.75rem; color: var(--emerald); display: flex; align-items: center; gap: 6px; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--emerald); animation: pulse 1.5s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    
    .hero { text-align: center; padding: 70px 0 50px; }
    h1 { font-family: var(--font-mono); font-size: 2.8rem; font-weight: 900; margin-bottom: 12px; }
    .tagline { font-size: 1.25rem; color: var(--emerald); font-weight: 600; margin-bottom: 16px; }
    .desc { color: var(--text-muted); font-size: 0.95rem; max-width: 720px; margin: 0 auto 32px; }
    
    .box { background: #000; border: 1px solid var(--border); border-radius: 10px; padding: 16px; max-width: 600px; margin: 0 auto 40px; font-family: var(--font-mono); font-size: 0.85rem; text-align: left; }
    .box-header { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 8px; }
    .code-line { background: #121215; padding: 10px 14px; border-radius: 6px; border: 1px solid var(--border); color: #34d399; font-weight: bold; overflow-x: auto; }
    
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 50px; }
    .card { background: var(--card-bg); border: 1px solid var(--border); padding: 22px; border-radius: 12px; }
    .card h3 { font-family: var(--font-mono); font-size: 1.05rem; margin-bottom: 8px; color: #fff; }
    .card p { font-size: 0.85rem; color: var(--text-muted); }
    
    .table-box { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 50px; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-mono); font-size: 0.85rem; }
    th, td { padding: 14px 18px; border-bottom: 1px solid var(--border); }
    th { background: #27272a; color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; }
    .speedup { color: var(--emerald); font-weight: bold; }
    
    footer { border-top: 1px solid var(--border); padding-top: 30px; text-align: center; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); }
    footer a { color: var(--emerald); text-decoration: none; }
  </style>
</head>
<body>
