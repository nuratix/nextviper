  <main class="container">
    <section class="hero">
      <h1>""" + hero_title + """</h1>
      <p class="tagline">""" + tagline + """</p>
      <p class="desc">""" + desc + """</p>
      
      <div class="box">
        <div class="box-header">POSIX One-Line Installer</div>
        <div class="code-line">curl -fsSL https://nextviper.nuratix.com/install.sh | sh</div>
      </div>
    </section>

    <div class="grid">
      <div class="card">
        <h3>⚡ Native C++20 AOT Speed</h3>
        <p>Direct compilation to standalone ELF/Mach-O native binaries with constant folding and register allocation.</p>
      </div>
      <div class="card">
        <h3>🔥 Vulkan GPU Compute</h3>
        <p>Built-in parallel GEMM compute shaders across NVIDIA, AMD, Intel, and Apple Silicon graphics hardware.</p>
      </div>
      <div class="card">
        <h3>🧠 Autograd Tensor Engine</h3>
        <p>Reverse-mode automatic differentiation and deep learning layers directly in the standard library.</p>
      </div>
    </div>

    <div class="table-box">
      <table>
        <thead>
          <tr>
            <th>Workload</th>
            <th>NextViper Native</th>
            <th>Python 3.14</th>
            <th>Calculated Speedup</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Prime Arithmetic (N=5000)</td>
            <td>9.52 ms</td>
            <td>97.91 ms</td>
            <td class="speedup">""" + b1_speedup + """ faster</td>
          </tr>
          <tr>
            <td>Nested Loops (1M Iterations)</td>
            <td>29.35 ms</td>
            <td>465.97 ms</td>
            <td class="speedup">""" + b2_speedup + """ faster</td>
          </tr>
          <tr>
            <td>Dense 60x60 Tensor Matmul</td>
            <td>27.01 ms</td>
            <td>144.66 ms</td>
            <td class="speedup">""" + b3_speedup + """ faster</td>
