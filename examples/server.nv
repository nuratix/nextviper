    </footer>
  </main>
</body>
</html>"""

// ------------------------------------------------------------------------------
// 2. Server Loop & Localhost Hosting
// ------------------------------------------------------------------------------

export fn start_server(port: int):
    io.print("==================================================")
    io.print("  NEXTVIPER HTTP WEB SERVER (v1.0.0 Apex)        ")
    io.print("==================================================")
    
    let html_content = build_landing_html()
    let web_root = "/tmp/nextviper_webroot"
    
    process.exec("mkdir -p " + web_root)
    fs.write_file(web_root + "/index.html", html_content)
    
    io.print("Landing page HTML generated at: " + web_root + "/index.html")
    io.print("Starting HTTP listener on: http://0.0.0.0:" + str(port) + " (Accessible on all interfaces)")
    io.print("Listening for incoming HTTP requests... (Press Ctrl+C to stop)")
    
    // Start lightweight HTTP serving daemon binding to all interfaces (0.0.0.0)
    let cmd = "python3 -m http.server " + str(port) + " --bind 0.0.0.0 --directory " + web_root
    let res = process.exec(cmd)
    io.print("Server process ended with code: " + str(res["exit_code"]))

export fn run():
    start_server(8080)

run()
