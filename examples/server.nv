// ------------------------------------------------------------------------------
// 1. Landing Page Data & Dynamic Business Logic
// ------------------------------------------------------------------------------

fn compute_speedup(nv_time: float, py_time: float) -> float:
    if nv_time <= 0.0:
        return 1.0
    return math.floor((py_time / nv_time) * 10.0) / 10.0

fn build_landing_html():
    let hero_title = "NextViper Programming Language"
    let tagline = "High-Performance Language for Data, Tensor, AI & Vulkan GPU Compute"
    let desc = "Deterministic native speed, zero-GC pauses (RAII), first-class columnar DataFrames, reverse-mode autograd, and Vulkan GPU acceleration."
    
    let b1_speedup = str(compute_speedup(9.52, 97.91)) + "x"
    let b2_speedup = str(compute_speedup(29.35, 465.97)) + "x"
    let b3_speedup = str(compute_speedup(27.01, 144.66)) + "x"

    return """<!DOCTYPE html>
<html lang="en">
<head>
