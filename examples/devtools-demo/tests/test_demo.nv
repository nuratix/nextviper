// examples/devtools-demo/tests/test_demo.nv
// Automated test executed by `nextviper test`

import std.io

fn test_fibonacci():
    let a = 0
    let b = 1
    let i = 2
    while i <= 10:
        let c = a + b
        a = b
        b = c
        i = i + 1
    if b != 55:
        io.print_error("Fibonacci test failed: expected 55, got " + str(b))
        return 1
    return 0

fn test_metrics():
    let nums = [1, 2, 3, 4, 5]
    let total = 0
    for n in nums:
        total = total + n
    if total != 15:
        io.print_error("Sum test failed: expected 15, got " + str(total))
        return 1
    return 0

fn run_all():
    let res1 = test_fibonacci()
    let res2 = test_metrics()
    if res1 != 0 or res2 != 0:
        return 1
    return 0

run_all()
